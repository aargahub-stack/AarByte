# Supabase Configuration (Frontend Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key

# Supabase Administrative / Database Seeding (Backend Scripts Only - NEVER expose to frontend or commit to git)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SECRET_KEY=your-secret-key-do-not-expose

# Wandbox API endpoint (default: https://wandbox.org/api) - 100% Free, no API key needed
VITE_WANDBOX_API_URL=https://wandbox.org/api

# Optional: Piston API endpoint (if you run self-hosted Docker)
# VITE_PISTON_API_URL=http://localhost:2000/api/v2

